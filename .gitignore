# ========== Python 运行缓存 ==========
# 运行 .py 时自动生成的字节码缓存,每次运行都会变,毫无提交价值
__pycache__/
*.py[cod]
*$py.class

# ========== IDE 配置文件 ==========
# PyCharm 的项目配置,含本机路径信息,提交了会导致团队间配置冲突
.idea/
# VS Code 配置
.vscode/

# ========== 数据集 ==========
# 猫狗数据集约 1GB,太大且可重新下载,绝不能提交进 git
data/
dataset/

# ========== 训练产物 ==========
# 模型权重文件,重新训练一遍就能得到,且体积大
*.pth
*.pt
*.ckpt
*.onnx
# 训练日志 / 输出目录
logs/
runs/
outputs/

# ========== 系统 / 临时文件 ==========
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
